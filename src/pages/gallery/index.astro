---
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import { IconChevronDown } from "@tabler/icons-astro";
import { galleryCategories } from "../../data/galleryCategories";

const galleryItems = await getCollection("gallery");

// Sort by date desc
const sortedGallery = galleryItems.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// <Image> emits responsive, width-constrained thumbnails for the masonry grid
// (and carries intrinsic dimensions, so no layout shift). The modal/lightbox
// loads on demand, so pre-generate one optimized, width-capped variant per
// image for it — capped at the source width to avoid upscaling.
async function modalSources(item: (typeof sortedGallery)[0]) {
    const srcs =
        item.data.images && item.data.images.length > 0
            ? item.data.images
            : [item.data.image];
    return Promise.all(
        srcs.map((src) =>
            getImage({
                src,
                width: Math.min(1400, src.width),
                format: "webp",
                quality: 82,
            }).then((r) => r.src),
        ),
    );
}

// Render body content + optimized modal images for each item
const galleryWithBody = await Promise.all(
    sortedGallery.map(async (item) => {
        const { Content } = await render(item);
        const modalImages = await modalSources(item);
        return { item, Content, modalImages };
    }),
);

// Featured count
const featuredCount = sortedGallery.filter(
    (item) => item.data.featured,
).length;

const categories = galleryCategories.map((name) => ({
    name,
    count: sortedGallery.filter((item) => item.data.category === name).length,
}));

// Build metadata JSON for modal
function buildMeta(item: (typeof sortedGallery)[0], modalImages: string[]) {
    const d = item.data;
    const exifParts = [
        d.focalLength,
        d.aperture,
        d.shutterSpeed,
        d.iso ? `ISO ${d.iso}` : null,
    ]
        .filter(Boolean)
        .join(" · ");
    return JSON.stringify({
        title: d.title,
        image: modalImages[0],
        images: modalImages,
        date: d.date.toISOString().split("T")[0],
        location: d.location || "",
        camera: d.camera || "",
        lens: d.lens || "",
        filmStock: d.filmStock || "",
        exif: exifParts,
        category: d.category,
    }).replace(/</g, "\\u003c");
}
---

<MinimalLayout title="Gallery | Audiofool" description="Obscured by Clouds">
    <div class="p-6 md:p-12" transition:animate="fade">
        <!-- Header -->
        <div class="mb-4 md:mb-8">
            <h1 class="text-4xl font-bold font-heading mb-2">Gallery</h1>
            <p
                class="font-mono text-sm text-[var(--text-muted)] tracking-wider uppercase"
            >
                Obscured by Clouds
            </p>
        </div>

        <div id="gallery-filters" hidden>
            <div class="gallery-toolbar">
                <div class="gallery-views" role="group" aria-label="Photo selection">
                    <button type="button" data-gallery-view="all" aria-pressed="true" class="gallery-filter-button gallery-view-button">
                        All photos <span class="gallery-count">{sortedGallery.length}</span>
                    </button>
                    {featuredCount > 0 && (
                        <button type="button" data-gallery-view="featured" aria-pressed="false" class="gallery-filter-button gallery-view-button">
                            Featured <span class="gallery-count">{featuredCount}</span>
                        </button>
                    )}
                </div>
                <div id="gallery-sort-controls" class="gallery-sort" hidden>
                    <label for="gallery-sort-order" class="gallery-sort-label">Sort:</label>
                    <div class="gallery-sort-select">
                        <select id="gallery-sort-order" name="order" aria-label="Sort photos">
                            <option value="newest">Newest</option>
                            <option value="oldest">Oldest</option>
                            <option value="location">Location</option>
                            <option value="shuffle">Shuffle</option>
                        </select>
                        <IconChevronDown size={16} stroke={1.5} aria-hidden="true" />
                    </div>
                    <button type="button" id="gallery-reshuffle" hidden>Reshuffle</button>
                    <span id="gallery-sort-status" class="sr-only" role="status"></span>
                </div>
            </div>
            <div class="gallery-subjects" role="group" aria-labelledby="gallery-subject-label">
                <span id="gallery-subject-label" class="gallery-subject-label">Subject</span>
                <div class="gallery-subject-options">
                    <button type="button" data-gallery-subject="all" aria-pressed="true" class="gallery-filter-button gallery-subject-button">All</button>
                    {categories.map(({ name, count }) => (
                        <button type="button" data-gallery-subject={name} aria-pressed="false" class="gallery-filter-button gallery-subject-button">
                            <span>{name}</span><span class="gallery-count" data-subject-count>{count}</span>
                        </button>
                    ))}
                </div>
            </div>
        </div>
        <div class="gallery-results">
            <p id="gallery-filter-status" role="status" aria-atomic="true">Showing {sortedGallery.length} photos</p>
            <button type="button" id="gallery-filter-reset" hidden>Clear filters</button>
        </div>
        <p id="gallery-filter-empty" class="gallery-empty" hidden></p>

        <!-- Masonry Layout -->
        <div class="gallery-masonry">
            {
                galleryWithBody.map(({ item, Content, modalImages }, i) => (
                    <div
                        data-category={item.data.category}
                        data-featured={item.data.featured ? "true" : "false"}
                        data-meta-id={`gallery-meta-${i}`}
                        data-index={i}
                        role="button"
                        tabindex="0"
                        aria-label={`View ${item.data.title}`}
                        class="gallery-item group block mb-4 break-inside-avoid border border-[var(--border-main)] overflow-hidden cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--text-main)]"
                    >
                        <Image
                            src={item.data.image}
                            alt={item.data.title}
                            width={640}
                            widths={[320, 480, 640, 960]}
                            sizes="(min-width: 1440px) 350px, (min-width: 1024px) calc((100vw - 388px) / 3), (min-width: 768px) calc((100vw - 372px) / 2), (min-width: 640px) calc((100vw - 68px) / 2), calc(100vw - 52px)"
                            class="w-full h-auto block transition-transform duration-300 group-hover:scale-[1.03]"
                            loading={i === 0 ? "eager" : "lazy"}
                            fetchpriority={i === 0 ? "high" : "auto"}
                            decoding="async"
                            quality={76}
                        />
                        <div class="p-3 border-t border-[var(--border-main)]">
                            <h3 class="font-bold text-sm truncate">
                                {item.data.title}
                            </h3>
                            <div class="flex items-center justify-between mt-1">
                                <span class="font-mono text-[10px] text-[var(--text-muted)]">
                                    {item.data.date
                                        .toISOString()
                                        .split("T")[0]}
                                </span>
                                {item.data.location && (
                                    <span class="font-mono text-[10px] text-[var(--text-muted)] truncate ml-2">
                                        {item.data.location}
                                    </span>
                                )}
                            </div>
                        </div>
                        {/* Hidden body for modal */}
                        <div class="gallery-body hidden">
                            <Content />
                        </div>
                        <script
                            is:inline
                            type="application/json"
                            id={`gallery-meta-${i}`}
                            set:html={buildMeta(item, modalImages)}
                        ></script>
                    </div>
                ))
            }
        </div>

        {
            sortedGallery.length === 0 && (
                <div class="py-12 text-center text-[var(--text-muted)]">
                    No images found. Clouds are obscuring everything.
                </div>
            )
        }
    </div>

    <!-- Modal Overlay -->
    <div
        id="gallery-modal"
        class="fixed inset-0 z-[9999] opacity-0 pointer-events-none transition-opacity duration-200"
        role="dialog"
        aria-modal="true"
    >
        <!-- Backdrop -->
        <div
            id="modal-backdrop"
            class="absolute inset-0 bg-[var(--bg-body)] dark:bg-black"
        >
        </div>

        <!-- Unified viewer: image first, metadata footer only as tall as needed -->
        <div
            id="modal-scroll"
            class="absolute inset-0 flex items-stretch justify-center overflow-hidden"
        >
            <!-- Close button -->
            <button
                id="modal-close"
                type="button"
                class="absolute top-3 right-3 md:top-5 md:right-5 z-30 font-mono text-[var(--text-muted)] hover:text-[var(--text-main)] dark:text-white/70 dark:hover:text-white text-2xl w-10 h-10 flex items-center justify-center transition-colors"
                aria-label="Close"
            >
                &times;
            </button>

            <!-- Viewer -->
            <div
                id="modal-content"
                class="relative w-full h-[100dvh] max-h-[100dvh] overflow-hidden bg-[var(--bg-body)] dark:bg-black flex flex-col"
            >
                <!-- Image area -->
                <div
                    id="modal-image-wrap"
                    class="modal-image-area relative min-h-0 flex-1 flex items-center justify-center bg-[var(--bg-body)] dark:bg-black overflow-hidden px-2 pt-12 pb-2 md:px-8 md:pt-10 md:pb-4"
                >
                    <button
                        id="modal-prev-zone"
                        type="button"
                        aria-label="Previous photo"
                        class="modal-nav-zone modal-nav-zone-prev"
                    >
                        <span aria-hidden="true">&larr;</span>
                    </button>
                    <button
                        id="modal-next-zone"
                        type="button"
                        aria-label="Next photo"
                        class="modal-nav-zone modal-nav-zone-next"
                    >
                        <span aria-hidden="true">&rarr;</span>
                    </button>
                    <img
                        id="modal-image"
                        src=""
                        alt=""
                        draggable="false"
                        class="max-w-full max-h-full object-contain select-none transition-opacity duration-150 block"
                    />
                </div>

                <!-- Info footer -->
                <div
                    id="modal-info"
                    class="modal-info-area flex-shrink-0 overflow-y-auto border-t border-[var(--border-main)] flex flex-col bg-[var(--bg-body)] dark:bg-black"
                >
                    <div
                        class="modal-footer-grid mx-auto w-full max-w-4xl"
                    >
                        <span
                            id="modal-counter-mobile"
                            class="modal-footer-counter font-mono text-[10px] md:text-xs text-[var(--text-faint)]"
                        ></span>
                        <div class="modal-footer-main">
                            <h2
                                id="modal-title-mobile"
                                class="modal-footer-title min-w-0 text-base md:text-xl font-bold font-heading"
                            ></h2>
                            <div
                                id="modal-body-mobile"
                                class="modal-footer-body text-xs md:text-sm text-[var(--text-muted)] leading-relaxed"
                            ></div>
                        </div>

                        <div class="modal-footer-rail">
                            <div
                                class="modal-footer-meta flex flex-wrap gap-x-3 gap-y-1 font-mono text-[10px] md:text-xs text-[var(--text-muted)]"
                            >
                                <span id="modal-date-mobile"></span>
                                <span id="modal-location-mobile"></span>
                                <span id="modal-camera-mobile"></span>
                                <span id="modal-lens-mobile"></span>
                                <span id="modal-film-mobile"></span>
                                <span id="modal-exif-mobile"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fullscreen Lightbox -->
    <div
        id="lightbox"
        class="fixed inset-0 z-[10000] bg-black/95 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 cursor-zoom-out backdrop-blur-sm"
    >
        <img
            id="lightbox-image"
            src=""
            alt=""
            class="max-h-[95vh] max-w-[95vw] object-contain"
        />
    </div>

    <script>
        import "../../scripts/galleryFilters";
        import "../../scripts/gallerySort";
        import "../../scripts/galleryViewer.js";
    </script>



    <style>
        .gallery-masonry {
            columns: 1;
            column-gap: 1rem;
        }
        @media (min-width: 640px) {
            .gallery-masonry {
                columns: 2;
            }
        }
        @media (min-width: 1024px) {
            .gallery-masonry {
                columns: 3;
            }
        }

        .modal-image-area {
            min-height: 0;
        }

        .modal-nav-zone {
            position: absolute;
            top: 0;
            bottom: 0;
            z-index: 10;
            display: flex;
            width: 50%;
            align-items: center;
            border: 0;
            background: transparent;
            color: rgb(255 255 255 / 0.72);
            font-family: var(--font-mono, "JetBrains Mono", monospace);
            font-size: 1rem;
            transition: background-color 150ms ease;
        }

        .modal-nav-zone span {
            opacity: 0;
            transition:
                opacity 150ms ease,
                transform 150ms ease;
        }

        .modal-nav-zone-prev {
            left: 0;
            justify-content: flex-start;
            padding-left: clamp(1.25rem, 5vw, 4rem);
            cursor: w-resize;
        }

        .modal-nav-zone-next {
            right: 0;
            justify-content: flex-end;
            padding-right: clamp(1.25rem, 5vw, 4rem);
            cursor: e-resize;
        }

        .modal-nav-zone:disabled {
            pointer-events: none;
        }

        .modal-nav-zone:focus-visible {
            outline: none;
        }

        .modal-nav-zone:focus-visible span {
            opacity: 1;
        }

        @media (hover: hover) {
            .modal-nav-zone-prev:hover {
                background: linear-gradient(
                    to right,
                    rgb(255 255 255 / 0.06),
                    transparent 55%
                );
            }

            .modal-nav-zone-next:hover {
                background: linear-gradient(
                    to left,
                    rgb(255 255 255 / 0.06),
                    transparent 55%
                );
            }

            .modal-nav-zone:hover span {
                opacity: 0.72;
            }

            .modal-nav-zone-prev:hover span {
                transform: translateX(-0.25rem);
            }

            .modal-nav-zone-next:hover span {
                transform: translateX(0.25rem);
            }
        }

        .modal-info-area {
            height: clamp(9.75rem, 28dvh, 11.5rem);
            min-height: 0;
            overscroll-behavior: contain;
            -webkit-overflow-scrolling: touch;
        }

        .modal-footer-grid {
            display: grid;
            grid-template-rows: minmax(0, 1fr) auto;
            gap: 0.7rem;
            height: 100%;
            position: relative;
            padding: 1rem 1.25rem 0.85rem;
            text-align: center;
        }

        .modal-footer-main {
            display: flex;
            min-width: 0;
            min-height: 0;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .modal-footer-counter {
            position: absolute;
            top: 0.8rem;
            right: 1.25rem;
            white-space: nowrap;
        }

        .modal-footer-title {
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .modal-footer-body {
            display: -webkit-box;
            margin: 0 auto;
            max-width: 44rem;
            overflow: hidden;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
        }

        .modal-footer-body :where(p) {
            display: inline;
            margin: 0;
        }

        .modal-footer-body :where(p + p)::before {
            content: " ";
        }

        .modal-footer-rail {
            display: grid;
            width: 100%;
            min-width: 0;
            grid-template-columns: minmax(0, 1fr);
            align-items: end;
        }

        .modal-footer-meta {
            min-width: 0;
            overflow-x: auto;
            overflow-y: hidden;
            flex-wrap: nowrap;
            justify-content: flex-start;
            padding-bottom: 0.35rem;
            text-align: left;
            white-space: nowrap;
            overscroll-behavior-x: contain;
            scrollbar-color: rgb(255 255 255 / 0.24) transparent;
            scrollbar-width: thin;
            -webkit-overflow-scrolling: touch;
        }

        .modal-footer-meta span {
            flex: 0 0 auto;
        }

        .modal-footer-meta::-webkit-scrollbar {
            height: 0.2rem;
        }

        .modal-footer-meta::-webkit-scrollbar-track {
            background: transparent;
        }

        .modal-footer-meta::-webkit-scrollbar-thumb {
            background: rgb(255 255 255 / 0.22);
            border-radius: 999px;
        }

        @media (min-width: 768px) {
            .modal-info-area {
                height: clamp(7.75rem, 20dvh, 9.25rem);
            }

            .modal-footer-grid {
                gap: 0.8rem;
                padding: 1rem 2rem 0.9rem;
            }

            .modal-footer-counter {
                top: 0.9rem;
                right: 2rem;
            }

            .modal-footer-body {
                -webkit-line-clamp: 2;
            }
        }

        @media (max-width: 767px) {
            .modal-footer-meta {
                -webkit-mask-image: linear-gradient(
                    to right,
                    #000 calc(100% - 1.5rem),
                    transparent
                );
                mask-image: linear-gradient(
                    to right,
                    #000 calc(100% - 1.5rem),
                    transparent
                );
            }
        }

        #gallery-filters[hidden],
        #gallery-sort-controls[hidden],
        #gallery-filter-reset[hidden],
        #gallery-reshuffle[hidden],
        #gallery-filter-empty[hidden] {
            display: none;
        }

        .gallery-toolbar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            column-gap: 1.5rem;
            padding-bottom: 0.25rem;
            border-bottom: 1px solid var(--border-main);
        }

        .gallery-views {
            display: flex;
            gap: 1.5rem;
        }

        .gallery-filter-button {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            min-height: 44px;
            padding: 0.5rem;
            text-align: left;
            color: var(--text-muted);
            transition: color 150ms, background-color 150ms;
        }

        .gallery-filter-button:hover,
        .gallery-sort select:hover,
        .gallery-results button:hover,
        #gallery-reshuffle:hover {
            color: var(--text-main);
        }

        .gallery-filter-button[aria-pressed="true"] {
            color: var(--text-main);
            background-color: color-mix(in srgb, var(--text-main) 7%, var(--bg-body));
            font-weight: 600;
        }

        .gallery-filter-button[aria-pressed="true"] .gallery-count {
            color: var(--text-muted);
        }

        .gallery-view-button {
            font-size: 1rem;
        }

        .gallery-count,
        .gallery-subjects,
        .gallery-sort,
        .gallery-results {
            font-family: var(--font-mono, "JetBrains Mono", monospace);
        }

        .gallery-count {
            font-size: 0.8125rem;
            font-weight: 400;
            color: var(--text-faint);
        }

        .gallery-sort {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-left: auto;
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .gallery-sort-select {
            position: relative;
        }

        .gallery-sort select {
            appearance: none;
            min-height: 44px;
            padding: 0.5rem 1.75rem 0.5rem 0.5rem;
            border: 0;
            border-radius: 0;
            cursor: pointer;
            background: var(--bg-body);
            color: var(--text-main);
        }

        .gallery-sort-select :global(svg) {
            position: absolute;
            right: 0.25rem;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
        }

        #gallery-reshuffle {
            min-height: 44px;
            text-decoration: underline;
            text-underline-offset: 4px;
        }

        .gallery-subjects {
            padding-top: 1rem;
            padding-bottom: 0.25rem;
            border-bottom: 1px solid var(--border-main);
        }

        .gallery-subject-label {
            display: block;
            margin-bottom: 0.25rem;
            color: var(--text-faint);
            font-size: 0.75rem;
            text-transform: uppercase;
        }

        .gallery-subject-options {
            display: flex;
            flex-wrap: wrap;
            align-items: stretch;
            gap: 0.25rem 1rem;
        }

        .gallery-subject-button {
            font-size: clamp(0.875rem, 1.1vw, 1rem);
        }

        .gallery-results {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            column-gap: 1rem;
            min-height: 3.25rem;
            padding: 0.5rem 0;
            color: var(--text-muted);
            font-size: 0.8125rem;
        }

        .gallery-results button {
            min-height: 36px;
            text-decoration: underline;
            text-underline-offset: 4px;
        }

        .gallery-empty {
            padding: 2rem 0;
            color: var(--text-muted);
        }

        @media (max-width: 1100px) {
            .gallery-subject-options {
                gap: 0.25rem 0.5rem;
            }
        }

        @media (max-width: 639px) {
            .gallery-toolbar {
                column-gap: 0.75rem;
            }
            .gallery-views {
                gap: 0.5rem;
            }
            .gallery-view-button {
                font-size: 0.875rem;
            }
            .gallery-sort-label {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip-path: inset(50%);
            }
            .gallery-sort {
                gap: 0.25rem;
                font-size: 0.75rem;
            }
            .gallery-subject-options {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                column-gap: 1rem;
            }
            .gallery-subject-button {
                justify-content: space-between;
                font-size: 0.8125rem;
            }
            .gallery-subject-button[data-gallery-subject="all"] {
                justify-content: flex-start;
            }
            .gallery-subject-button .gallery-count {
                font-size: 0.75rem;
            }
            .gallery-subjects {
                padding-top: 0.75rem;
            }
            .gallery-results {
                min-height: 2.75rem;
                font-size: 0.75rem;
            }
        }
    </style>
</MinimalLayout>
