---
import { IconMoon, IconSunHigh } from "@tabler/icons-astro";

interface Props {
    id: string;
}

const { id } = Astro.props;
---

<button
    id={id}
    type="button"
    data-theme-toggle
    class="theme-toggle"
    aria-label="Switch to light theme"
    title="Switch to light theme"
>
    <IconMoon
        class="theme-toggle__glyph theme-toggle__glyph--moon"
        size={22}
        stroke={1.6}
        stroke-linecap="square"
        stroke-linejoin="miter"
        aria-hidden="true"
    />
    <IconSunHigh
        class="theme-toggle__glyph theme-toggle__glyph--sun"
        size={22}
        stroke={1.6}
        stroke-linecap="square"
        stroke-linejoin="miter"
        aria-hidden="true"
    />
</button>

<style>
    .theme-toggle {
        display: inline-flex;
        position: relative;
        width: 2rem;
        height: 2rem;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        color: var(--text-main);
        opacity: 0.72;
        transition: opacity 160ms ease;
    }

    .theme-toggle:hover {
        opacity: 1;
    }

    .theme-toggle :global(.theme-toggle__glyph) {
        position: absolute;
        transform-origin: center;
        transition:
            opacity 180ms ease,
            transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .theme-toggle :global(.theme-toggle__glyph--moon) {
        opacity: 1;
        transform: translateY(-1px) rotate(0deg) scale(1);
    }

    .theme-toggle :global(.theme-toggle__glyph--sun) {
        opacity: 0;
        transform: translateY(-1px) rotate(-12deg) scale(0.78);
    }

    :global(html.dark) .theme-toggle :global(.theme-toggle__glyph--moon) {
        opacity: 0;
        transform: translateY(-1px) rotate(12deg) scale(0.78);
    }

    :global(html.dark) .theme-toggle :global(.theme-toggle__glyph--sun) {
        opacity: 1;
        transform: translateY(-1px) rotate(0deg) scale(1);
    }

    .theme-toggle:hover :global(.theme-toggle__glyph--moon) {
        transform: translateY(-1.5px) scale(1.03);
    }

    :global(html.dark) .theme-toggle:hover :global(.theme-toggle__glyph--sun) {
        transform: translateY(-1.5px) scale(1.03);
    }

    .theme-toggle:active :global(.theme-toggle__glyph--moon) {
        transform: translateY(-0.5px) scale(0.9);
    }

    :global(html.dark) .theme-toggle:active :global(.theme-toggle__glyph--sun) {
        transform: translateY(-0.5px) scale(0.9);
    }

    @media (max-width: 767px) {
        .theme-toggle {
            width: 2.25rem;
            height: 2.25rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .theme-toggle,
        .theme-toggle :global(.theme-toggle__glyph) {
            transition: none;
        }
    }
</style>
